# Copy to .env at the repository root (config.py resolves ENV_PATH to ../.env
# relative to backend/) and fill in. Never commit the real .env.

# --- Database -----------------------------------------------------------
# Defaults to backend/training.db. The deployed container uses /data/training.db.
DB_PATH=

# --- Strava -------------------------------------------------------------
# Lowercase names are intentional; config.py reads them as written here.
strava_client_id=
strava_client_secret=
# Per-user Strava tokens are stored encrypted in the database, not here.
# The callback must be on the domain set as "Authorization Callback Domain" in
# the Strava app settings (production: runflow-api.skdev.one).
STRAVA_REDIRECT_URI=http://localhost:8000/api/strava/callback
strava_webhook_verify_token=
# The id Strava returns when you create the webhook subscription. Events carrying
# any other subscription_id are ignored. Leave empty to skip the check.
STRAVA_SUBSCRIPTION_ID=


# --- Accounts -----------------------------------------------------------
# Fernet key that encrypts every user's Strava and Garmin tokens at rest.
# Generate once and keep it: losing it makes stored tokens unreadable.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_KEY=
# Random string that signs the OAuth `state` of the Strava connect flow.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_STATE_SECRET=
# 1 (default) marks the session cookie Secure and uses the __Host-rf_session
# name. Set 0 only for local http development, which uses plain rf_session.
SESSION_COOKIE_SECURE=1
# Where the browser app lives; Strava's callback sends the user back here.
FRONTEND_URL=http://localhost:3000
# This API's public base URL, used to build links such as the connector URL.
PUBLIC_API_URL=http://localhost:8000

# --- Garmin -------------------------------------------------------------
# Each user connects their own Garmin in Settings; tokens are stored encrypted in
# the database. This directory is read once, by migrate_multiuser.py, to carry
# the owner's existing tokens over.
GARMIN_TOKENSTORE=/data/garmin_tokens

# --- LLM narrative and per-run chat ------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# --- MCP connector ------------------------------------------------------
# Read once, by migrate_multiuser.py, to carry the old single connector URL over
# to the owner. The running app ignores it. Users get their own connector URL
# from Settings.
MCP_SECRET=
