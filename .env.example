# Copy to .env at the repository root (config.py resolves ENV_PATH to ../.env
# relative to backend/) and fill in. Never commit the real .env.

# --- Database -----------------------------------------------------------
# Defaults to backend/training.db. The deployed container uses /data/training.db.
DB_PATH=

# --- Strava -------------------------------------------------------------
# Lowercase names are intentional; config.py reads them as written here.
strava_client_id=
strava_client_secret=
# Per-user Strava tokens are stored encrypted in the database, not here.
STRAVA_REDIRECT_URI=http://localhost:8000/api/strava/callback
strava_webhook_verify_token=
# The id Strava returns when you create the webhook subscription. Events carrying
# any other subscription_id are ignored. Leave empty to skip the check.
STRAVA_SUBSCRIPTION_ID=

# --- Garmin -------------------------------------------------------------
# Garmin uses a saved OAuth token store rather than credentials in env.
# See GARMIN.md for how to create it.
GARMIN_TOKENSTORE=/data/garmin_tokens

# --- LLM narrative and per-run chat ------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# --- MCP connector ------------------------------------------------------
# The connector mounts at /mcp/<MCP_SECRET>/mcp. Leave unset and it is not
# mounted at all. This value is the credential: treat it like a password.
MCP_SECRET=
